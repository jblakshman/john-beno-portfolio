---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import monaLatin from '@fontsource-variable/mona-sans/files/mona-sans-latin-standard-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  /** Page name. Leave empty on the home page. */
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: object;
  noindex?: boolean;
  /** Playground pages always render dark. */
  forceDark?: boolean;
  footer?: boolean;
}

const {
  title,
  description = site.description,
  image,
  imageAlt,
  ogType = 'website',
  jsonLd,
  noindex = false,
  forceDark = false,
  footer = true,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} – ${site.role} in ${site.location.city}`;
// build.format is 'file', so strip ".html" and "index" to get the clean public URL.
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href;

let ogImage = new URL('/og/default.png', site.url).href;
let ogAlt = `${site.name}, ${site.role}`;
if (image) {
  const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
  ogImage = new URL(og.src, site.url).href;
  ogAlt = imageAlt ?? ogAlt;
}
---

<!doctype html>
<html lang="en" data-force={forceDark ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={site.name} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0b" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={monaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      // Apply the saved theme before first paint so there is no flash.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={forceDark ? 'force-dark' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header contactHref={footer ? '#contact' : '/#contact'} />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
    <div class="cursor-label" aria-hidden="true"><span></span></div>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
