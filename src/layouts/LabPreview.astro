---
import '../styles/lab/tokens.css';
import '../styles/lab/base.css';
import '../styles/lab/layout.css';
import '../styles/lab/case.css';
import LabNav from '../components/lab/LabNav.astro';
import LabFooter from '../components/lab/LabFooter.astro';
import { defaults, STORAGE_KEY } from '../lab/options';
import { site } from '../site.config';

interface Props {
  title: string;
  footer?: boolean;
}
const { title, footer = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Studio preview</title>
    <style is:inline>@view-transition { navigation: auto; } @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }</style>
    <link rel="expect" href="#main" blocking="render" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <script is:inline define:vars={{ defaults, STORAGE_KEY }}>
      // Apply the chosen configuration before the first paint.
      var c = Object.assign({}, defaults);
      try { Object.assign(c, JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}')); } catch (e) {}
      try {
        var m = location.hash.match(/c=([^&]+)/);
        if (m) Object.assign(c, JSON.parse(decodeURIComponent(escape(atob(decodeURIComponent(m[1]))))));
      } catch (e) {}
      var r = document.documentElement;
      for (var k in defaults) r.setAttribute('data-' + k, c[k]);
      // Where the clicked card was, for the Open transition.
      try {
        var o = JSON.parse(sessionStorage.getItem('jb-vt-rect') || 'null');
        if (o) {
          var W = innerWidth, H = innerHeight;
          r.style.setProperty('--o-t', Math.max(0, o.t) + 'px');
          r.style.setProperty('--o-l', Math.max(0, o.l) + 'px');
          r.style.setProperty('--o-r', Math.max(0, W - o.r) + 'px');
          r.style.setProperty('--o-b', Math.max(0, H - o.b) + 'px');
          r.style.setProperty('--o-rad', (o.rad || 0) + 'px');
          r.style.setProperty('--o-cx', ((o.l + o.r) / 2) + 'px');
          r.style.setProperty('--o-cy', ((o.t + o.b) / 2) + 'px');
        }
      } catch (e) {}
      // Direction for Push and Open.
      window.addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        try {
          var a = navigation.activation;
          if (a && a.navigationType === 'traverse' && a.from && a.entry && a.from.index > a.entry.index) r.dataset.dir = 'back';
          e.viewTransition.finished.then(function () { delete r.dataset.dir; }, function () { delete r.dataset.dir; });
        } catch (err) {}
      });
    </script>
  </head>
  <body>
    <LabNav />
    <main id="main"><slot /></main>
    {footer && <LabFooter />}
    <div class="cur cur--label" aria-hidden="true"><span></span></div>
    <div class="ptr" aria-hidden="true"><span></span></div>
    <div class="grain" aria-hidden="true"></div>
    <canvas class="daylight" aria-hidden="true"></canvas>
    <script>
      import '../lab/runtime.ts';
    </script>
  </body>
</html>
