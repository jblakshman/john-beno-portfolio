---
import '../styles/lab/tokens.css';
import '../styles/lab/base.css';
import '../styles/lab/layout.css';
import '../styles/lab/case.css';
import LabNav from '../components/lab/LabNav.astro';
import LabFooter from '../components/lab/LabFooter.astro';
import { defaults, STORAGE_KEY } from '../lab/options';
import { site } from '../site.config';

interface Props {
  title: string;
  footer?: boolean;
}
const { title, footer = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Studio preview</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <script is:inline define:vars={{ defaults, STORAGE_KEY }}>
      // Apply the chosen configuration before the first paint.
      var c = Object.assign({}, defaults);
      try { Object.assign(c, JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}')); } catch (e) {}
      try {
        var m = location.hash.match(/c=([^&]+)/);
        if (m) Object.assign(c, JSON.parse(decodeURIComponent(escape(atob(decodeURIComponent(m[1]))))));
      } catch (e) {}
      var r = document.documentElement;
      for (var k in defaults) r.setAttribute('data-' + k, c[k]);
      try {
        var p = JSON.parse(sessionStorage.getItem('jb-vt-point') || 'null');
        if (p) { r.style.setProperty('--vt-x', p.x + 'px'); r.style.setProperty('--vt-y', p.y + 'px'); sessionStorage.removeItem('jb-vt-point'); }
      } catch (e) {}
      // Direction for the Push transition.
      window.addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        if (r.dataset.pt === 'none') { e.viewTransition.skipTransition(); return; }
        try {
          var a = navigation.activation;
          if (a && a.navigationType === 'traverse' && a.from && a.entry && a.from.index > a.entry.index) r.dataset.dir = 'back';
          e.viewTransition.finished.finally(function () { delete r.dataset.dir; });
        } catch (err) {}
      });
      window.addEventListener('pageswap', function (e) {
        if (e.viewTransition && r.dataset.pt === 'none') e.viewTransition.skipTransition();
        try {
          if (e.viewTransition && navigation.activation && e.activation && e.activation.navigationType === 'traverse' && e.activation.entry.index < navigation.currentEntry.index) r.dataset.dir = 'back';
        } catch (err) {}
      });
    </script>
  </head>
  <body>
    <div class="intro intro--name" aria-hidden="true"><p class="d"><span class="ic-w">{site.name}</span></p></div>
    <div class="intro intro--curtain" aria-hidden="true">
      <div class="ic"><p class="d" style="font-size: var(--t-xl)">{site.name}</p><p class="lbl">{site.location.city} · <time data-clock class="tab">--:--</time></p></div>
    </div>
    <LabNav />
    <main id="main"><slot /></main>
    {footer && <LabFooter />}
    <div class="prog prog--bar" aria-hidden="true"></div>
    <div class="prog prog--ruler" aria-hidden="true"></div>
    <div class="prog prog--counter lbl" aria-hidden="true"><span data-counter-n class="tab">01</span><b data-counter-t>Introduction</b></div>
    <div class="cur cur--label" aria-hidden="true"><span></span></div>
    <div class="cur cur--dot" aria-hidden="true"><i></i></div>
    <div class="grain" aria-hidden="true"></div>
    <script>
      import '../lab/runtime.ts';
    </script>
  </body>
</html>
