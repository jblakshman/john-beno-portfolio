---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { site } from '../site.config';
import { graph, person, website } from '../lib/schema';
import portrait from '../assets/about/portrait-standing.jpg';
import { getImage } from 'astro:assets';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const portraitSchema = await getImage({ src: portrait, width: 800, format: 'jpg' });
const jsonLd = graph(website(), person(new URL(portraitSchema.src, site.url).href));
---

<Base jsonLd={jsonLd}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-title">
      <span class="rise" style="--i:0">{site.name}</span>
      <span class="chip rise" style="--i:1" aria-hidden="true">
        <Image src={portrait} alt="" width={160} height={160} fit="cover" position="top" loading="eager" />
      </span>
      <span class="hero-rest rise" style="--i:2">designs digital things that feel thoughtful, honest and well&#8209;crafted.</span>
    </h1>

    <dl class="hero-meta grid">
      <div class="rise" style="--i:3">
        <dt class="label">Role</dt>
        <dd>{site.role}</dd>
      </div>
      <div class="rise" style="--i:4">
        <dt class="label">Studying</dt>
        <dd>Computer Science &amp; Design,<br />Hochschule München</dd>
      </div>
      <div class="rise" style="--i:5">
        <dt class="label">Also into</dt>
        <dd>Photography, videography,<br />music production</dd>
      </div>
      <div class="rise" style="--i:6">
        <dt class="label">Based in</dt>
        <dd>{site.location.city}, {site.location.countryName} · <time data-clock class="tabular">--:--</time></dd>
      </div>
    </dl>
  </section>

  <section class="work wrap" id="work" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title" class="label label--ink">Selected work</h2>
      <p class="label tabular">({String(projects.length).padStart(2, '0')})</p>
    </div>
    {projects.map((p, i) => <ProjectRow project={p} eager={i === 0} />)}
  </section>

  <section class="about-teaser wrap grid" aria-labelledby="about-title">
    <h2 id="about-title" class="label label--ink about-label">About</h2>
    <div class="about-body">
      <p class="about-lead">
        I care about clarity, emotion and the small details that bring a sense of balance and purpose to a design. Alongside design I make
        photographs, videos and music, and all of it shapes how I approach a project.
      </p>
      <a class="pill" href="/about">More about me <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

</Base>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(64px, 10vw, 160px));
    padding-bottom: clamp(56px, 8vw, 112px);
  }
  .hero-title {
    font-size: var(--t-2xl);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 540;
    max-width: 18.5ch;
  }
  .hero-title > span {
    display: inline;
  }
  .hero-rest {
    color: var(--muted);
  }
  .chip {
    display: inline-block !important;
    vertical-align: -0.1em;
    width: 1.5em;
    height: 0.86em;
    margin-inline: 0.04em 0.12em;
    border-radius: 999px;
    overflow: hidden;
    background: var(--bg-elev);
    transition: width 0.6s var(--spring);
  }
  .chip :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    filter: grayscale(1);
    transition: filter 0.6s var(--ease), transform 0.8s var(--ease);
  }
  .hero-title:hover .chip {
    width: 2.4em;
  }
  .hero-title:hover .chip :global(img) {
    filter: grayscale(0.2);
    transform: scale(1.05);
  }
  .hero-meta {
    margin-top: clamp(48px, 7vw, 96px);
    row-gap: 24px;
  }
  .hero-meta > div {
    grid-column: span 3;
    display: grid;
    gap: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: var(--t-sm);
  }
  .hero-meta dd {
    color: var(--ink);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 14px;
  }

  .about-teaser {
    margin-top: clamp(96px, 12vw, 180px);
    row-gap: 20px;
  }
  .about-label {
    grid-column: 1 / span 4;
  }
  .about-body {
    grid-column: 5 / -1;
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .about-lead {
    font-size: var(--t-lg);
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 34ch;
    font-weight: 450;
  }

  @media (max-width: 900px) {
    .hero-meta > div {
      grid-column: span 6;
    }
    .about-label,
    .about-body {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .hero-meta > div {
      grid-column: 1 / -1;
    }
  }
</style>
