---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
import { breadcrumbs, graph, person, personId } from '../../lib/schema';

export async function getStaticPaths() {
  const projects = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);
const sections = headings.filter((h) => h.depth === 2);
const url = `${site.url}/work/${project.id}`;

const jsonLd = graph(
  {
    '@type': 'CreativeWork',
    '@id': `${url}#work`,
    name: d.title,
    headline: `${d.title}: ${d.summary}`,
    description: d.description,
    url,
    author: { '@id': personId },
    creator: { '@id': personId },
    genre: d.disciplines,
    keywords: [...d.disciplines, ...d.tools].join(', '),
    inLanguage: 'en',
  },
  person(),
  breadcrumbs([
    { name: site.name, url: `${site.url}/` },
    { name: 'Work', url: `${site.url}/#work` },
    { name: d.title, url },
  ]),
);
---

<Base title={d.title} description={d.description} image={d.cover} imageAlt={d.coverAlt} ogType="article" jsonLd={jsonLd}>
  <article class="case">
    <header class="case-head wrap">
      <nav class="crumbs label" aria-label="Breadcrumb">
        <a class="link" href="/#work">Work</a> <span aria-hidden="true">/</span> <span aria-current="page">{d.title}</span>
      </nav>
      <h1 class="case-title rise">{d.title}</h1>
      <p class="case-summary rise" style="--i:1">{d.summary}</p>

      <dl class="case-meta grid">
        <div class="rise" style="--i:2">
          <dt class="label">Disciplines</dt>
          <dd>{d.disciplines.join(', ')}</dd>
        </div>
        <div class="rise" style="--i:3">
          <dt class="label">Tools</dt>
          <dd>{d.tools.join(', ')}</dd>
        </div>
        <div class="rise" style="--i:4">
          <dt class="label">Context</dt>
          <dd>{d.context}</dd>
        </div>
        <div class="rise" style="--i:5">
          <dt class="label">Link</dt>
          <dd>
            {
              d.liveUrl ? (
                <a class="link link--under" href={d.liveUrl} target="_blank" rel="noopener">
                  {d.liveLabel ?? 'See it live'} <span class="arrow arrow--ne" aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="muted">{d.status === 'in-progress' ? 'Coming soon' : '—'}</span>
              )
            }
          </dd>
        </div>
      </dl>
    </header>

    <div class="case-hero wrap">
      <div class="frame" style={`view-transition-name: work-${project.id}`}>
        <Picture
          src={d.cover}
          alt={d.coverAlt}
          formats={['avif', 'webp']} fallbackFormat="jpg"
          widths={[800, 1200, 1600, 2200]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="case-body wrap grid">
      {
        sections.length > 1 && (
          <aside class="toc" aria-label="On this page">
            <p class="label">On this page</p>
            <ol role="list">
              {sections.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc-link={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <nav class="next wrap" aria-label="Next project">
    <a class="next-link grid" href={`/work/${next.id}`} data-cursor="Next project">
      <div class="next-text">
        <p class="label">Next project</p>
        <p class="next-title">{next.data.title} <span class="arrow" aria-hidden="true">→</span></p>
        <p class="next-summary">{next.data.summary}</p>
      </div>
      <div class="next-media frame">
        <Picture src={next.data.cover} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 800, 1200]} sizes="(min-width: 900px) 40vw, 100vw" />
      </div>
    </a>
  </nav>
</Base>

<style>
  .case-head {
    padding-top: calc(var(--header-h) + clamp(48px, 8vw, 120px));
  }
  .crumbs {
    display: flex;
    gap: 8px;
    margin-bottom: clamp(20px, 3vw, 36px);
  }
  .crumbs [aria-current] {
    color: var(--ink);
  }
  .case-title {
    font-size: var(--t-display);
    line-height: 0.86;
    letter-spacing: -0.055em;
    font-weight: 600;
    font-variation-settings: 'wdth' 108;
    margin-left: -0.04em;
  }
  .case-summary {
    margin-top: clamp(20px, 3vw, 32px);
    font-size: var(--t-lg);
    line-height: 1.25;
    letter-spacing: -0.015em;
    max-width: 30ch;
    color: var(--ink-2);
  }
  .case-meta {
    margin-top: clamp(40px, 6vw, 72px);
    row-gap: 20px;
  }
  .case-meta > div {
    grid-column: span 3;
    display: grid;
    gap: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: var(--t-sm);
  }
  .case-hero {
    margin-top: clamp(32px, 5vw, 64px);
  }
  .case-hero .frame :global(img) {
    width: 100%;
    max-height: 88vh;
    object-fit: cover;
  }
  .case-body {
    margin-top: clamp(56px, 8vw, 120px);
    row-gap: 32px;
    align-items: start;
  }
  .toc {
    grid-column: 1 / span 3;
    position: sticky;
    top: calc(var(--header-h) + 32px);
    display: grid;
    gap: 14px;
  }
  .toc ol {
    display: grid;
    gap: 2px;
    font-size: var(--t-sm);
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-block: 3px;
    color: var(--muted);
    transition: color 0.25s var(--ease);
  }
  .toc a::before {
    content: '';
    width: 12px;
    height: 1px;
    background: currentColor;
    transition: width 0.35s var(--ease);
  }
  .toc a:hover,
  .toc a[data-active] {
    color: var(--ink);
  }
  .toc a[data-active]::before {
    width: 24px;
  }
  .prose {
    grid-column: 4 / -1;
    min-width: 0;
    font-size: var(--t-md);
    line-height: 1.6;
  }
  .prose > :global(p),
  .prose > :global(h2),
  .prose > :global(h3),
  .prose > :global(ul),
  .prose > :global(ol) {
    max-width: 62ch;
  }
  .prose :global(p + p) {
    margin-top: 1em;
  }
  .prose :global(h2) {
    font-size: var(--t-xl);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 560;
    margin-top: clamp(64px, 9vw, 128px);
    margin-bottom: 24px;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .prose > :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    font-size: var(--t-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: 40px;
    margin-bottom: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .next {
    margin-top: clamp(96px, 12vw, 180px);
  }
  .next-link {
    padding-top: 28px;
    border-top: 1px solid var(--line);
    row-gap: 20px;
    align-items: end;
  }
  .next-text {
    grid-column: 1 / span 6;
    display: grid;
    gap: 12px;
  }
  .next-title {
    font-size: var(--t-2xl);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 560;
  }
  .next-summary {
    color: var(--ink-2);
    max-width: 40ch;
  }
  .next-media {
    grid-column: 8 / -1;
    aspect-ratio: 3 / 2;
  }
  .next-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .next-link:hover .next-media :global(img) {
    transform: scale(1.04);
  }
  .next-link:hover .arrow {
    transform: translateX(6px);
  }

  @media (max-width: 900px) {
    .case-meta > div {
      grid-column: span 6;
    }
    .toc {
      display: none;
    }
    .prose {
      grid-column: 1 / -1;
    }
    .next-text,
    .next-media {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .case-meta > div {
      grid-column: 1 / -1;
    }
  }
</style>
