---
import '../../styles/site/tokens.css';
import { groups, presets, defaults, sections } from '../../design/options';

const swatches: Record<string, [string, string, string]> = {
  paper: ['#fafaf8', '#121211', '#3434f5'],
  bone: ['#eeebe4', '#1d1b16', '#56643a'],
  studio: ['#f5f5f7', '#1d1d1f', '#0a66d8'],
  velvet: ['#ebe5de', '#2a292e', '#8a6b79'],
  sage: ['#e3e8e0', '#17201a', '#2f5a3d'],
  ink: ['#0c0c0b', '#f2f1ed', '#a4a4ff'],
  graphite: ['#000000', '#f5f5f7', '#0a84ff'],
  midnight: ['#0b1020', '#ece9e1', '#cdb07a'],
};
const specimen: Record<string, string> = {
  mona: "'Mona Sans Variable'",
  native: "-apple-system, BlinkMacSystemFont, 'SF Pro Display', system-ui",
  gallery: "'Instrument Serif'",
  horology: "'Cormorant Garamond'",
  editorial: "'Newsreader Variable'",
  wide: "'Archivo Variable'",
};
const specimenVars: Record<string, string> = {
  wide: "font-variation-settings:'wdth' 125; font-weight: 640;",
  horology: 'font-weight: 400;',
  gallery: 'font-weight: 400;',
};
const openByDefault = ['layout', 'pt', 'imgin', 'hover', 'ambient'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Design Studio · John Beno Lakshman</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
  </head>
  <body>
    <div class="studio" data-device="desktop">
      <section class="stage" aria-label="Preview">
        <header class="bar">
          <div class="bar-l">
            <span class="logo">Studio</span>
            <span class="where" data-where>/ Home</span>
          </div>
          <div class="seg" role="radiogroup" aria-label="Preview size">
            <button type="button" role="radio" aria-checked="true" data-device-btn="desktop">Desktop</button>
            <button type="button" role="radio" aria-checked="false" data-device-btn="tablet">Tablet</button>
            <button type="button" role="radio" aria-checked="false" data-device-btn="phone">Phone</button>
          </div>
          <div class="bar-r">
            <button type="button" class="btn" data-try>Try transition</button>
            <a class="btn" href="/lab/p" target="_blank" rel="noopener" data-open-full>Open full screen ↗</a>
          </div>
        </header>
        <div class="viewport" data-viewport>
          <div class="device" data-device-frame>
            <iframe src="/lab/p" title="Website preview" data-frame></iframe>
          </div>
        </div>
      </section>

      <aside class="panel" aria-label="Configuration">
        <div class="p-head">
          <div>
            <h1>Your site</h1>
            <p>Change anything and the preview updates. Click projects in the preview to see page transitions and case studies.</p>
          </div>
          <div class="p-actions">
            <button type="button" class="btn" data-shuffle title="Random combination">Shuffle</button>
            <button type="button" class="btn" data-reset>Reset</button>
          </div>
        </div>

        <div class="presets" role="group" aria-label="Presets">
          {
            presets.map((p) => (
              <button type="button" class="preset" data-preset={p.id} title={p.note}>
                <span>{p.label}</span>
                <small>{p.note}</small>
              </button>
            ))
          }
        </div>

        <div class="groups">
          {
            sections.map((sec) => (
              <section class="sec" aria-label={sec}>
                <h2 class="sec-title">{sec}</h2>
                {groups
                  .filter((g) => g.section === sec)
                  .map((g) => (
                    <details class="group" data-group={g.id} open={openByDefault.includes(g.id)}>
                      <summary>
                        <span class="g-label">{g.label}</span>
                        <span class="g-value" data-value={g.id}>{g.options.find((o) => o.id === defaults[g.id])?.label}</span>
                        {g.id === 'pt' && (
                          <span class="g-try" role="button" tabindex="0" data-try>
                            Try it
                          </span>
                        )}
                      </summary>
                      <p class="g-hint">{g.hint}</p>
                      <div class:list={['opts', `opts--${g.id}`]} role="radiogroup" aria-label={g.label}>
                        {g.options.map((o) => (
                          <label class="opt" title={o.note}>
                            <input type="radio" name={g.id} value={o.id} checked={defaults[g.id] === o.id} />
                            {g.id === 'palette' && (
                              <span class="sw" aria-hidden="true" style={`--a:${swatches[o.id][0]};--b:${swatches[o.id][1]};--c:${swatches[o.id][2]}`}>
                                <i />
                                <i />
                                <i />
                              </span>
                            )}
                            {g.id === 'type' && (
                              <span class="spec" aria-hidden="true" style={`font-family:${specimen[o.id]};${specimenVars[o.id] ?? ''}`}>
                                Aa
                              </span>
                            )}
                            <span class="o-text">
                              <span class="o-name">{o.label}</span>
                              <span class="o-note">{o.note}</span>
                            </span>
                          </label>
                        ))}
                      </div>
                      {g.id === 'ambient' && (
                        <div class="hour">
                          <label for="lab-hour">
                            Time of day <output data-hour-out>now</output>
                          </label>
                          <input id="lab-hour" type="range" min="5" max="23.75" step="0.25" value="13" data-hour />
                          <button type="button" class="btn" data-hour-now>
                            Now
                          </button>
                        </div>
                      )}
                    </details>
                  ))}
              </section>
            ))
          }
        </div>

        <div class="p-foot">
          <button type="button" class="btn btn--solid" data-copy-setup>Copy my setup</button>
          <p>Paste it to Claude to build this exact combination into your real site.</p>
        </div>
      </aside>
    </div>
    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <script>
      import '../../design/studio.ts';
    </script>
  </body>
</html>

<style is:global>
  :root {
    --s-bg: #0d0d0d;
    --s-panel: #141414;
    --s-elev: #1c1c1c;
    --s-line: #262626;
    --s-ink: #ededed;
    --s-muted: #8d8d8d;
    --s-font: 'Mona Sans Variable', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body { background: var(--s-bg); color: var(--s-ink); font: 13px/1.45 var(--s-font); -webkit-font-smoothing: antialiased; overflow: hidden; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 2px solid #8fa8ff; outline-offset: 2px; border-radius: 6px; }

  .studio { display: grid; grid-template-columns: minmax(0, 1fr) 380px; height: 100dvh; }
  .stage { display: grid; grid-template-rows: auto minmax(0, 1fr); min-width: 0; }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; height: 52px; padding: 0 14px; border-bottom: 1px solid var(--s-line); }
  .bar-l { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .logo { font-weight: 650; letter-spacing: -0.01em; }
  .where { color: var(--s-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar-r { justify-self: end; display: flex; gap: 6px; }
  .btn { display: inline-flex; align-items: center; height: 30px; padding: 0 12px; border-radius: 8px; border: 1px solid var(--s-line); background: var(--s-elev); white-space: nowrap; transition: background 0.2s, border-color 0.2s; }
  .btn:hover { border-color: #3a3a3a; background: #232323; }
  .btn:active { transform: scale(0.98); }
  .btn--solid { background: #ededed; color: #0d0d0d; border-color: #ededed; font-weight: 600; height: 38px; width: 100%; justify-content: center; }
  .btn--solid:hover { background: #fff; border-color: #fff; }
  .seg { display: inline-flex; padding: 3px; gap: 2px; border-radius: 9px; background: var(--s-elev); border: 1px solid var(--s-line); }
  .seg button { height: 24px; padding: 0 10px; border-radius: 6px; color: var(--s-muted); }
  .seg button[aria-checked='true'] { background: #ededed; color: #0d0d0d; font-weight: 600; }

  .viewport { position: relative; overflow: hidden; display: grid; place-items: center; background: radial-gradient(circle at 1px 1px, #222 1px, transparent 0) 0 0 / 18px 18px, var(--s-bg); }
  .device { position: relative; width: 100%; height: 100%; transition: width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), height 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), border-radius 0.5s; overflow: hidden; background: #fff; transform-origin: 50% 50%; }
  .device iframe { width: 100%; height: 100%; border: 0; display: block; }
  .studio[data-device='tablet'] .device { width: 834px; height: 1112px; border-radius: 22px; box-shadow: 0 0 0 10px #050505, 0 0 0 11px #2a2a2a, 0 40px 80px -30px #000; }
  .studio[data-device='phone'] .device { width: 390px; height: 844px; border-radius: 48px; box-shadow: 0 0 0 10px #050505, 0 0 0 11px #2a2a2a, 0 40px 80px -30px #000; }

  .panel { display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; min-height: 0; background: var(--s-panel); border-left: 1px solid var(--s-line); }
  .p-head { display: grid; gap: 12px; padding: 16px 16px 12px; border-bottom: 1px solid var(--s-line); }
  .p-head h1 { margin: 0; font-size: 15px; font-weight: 650; letter-spacing: -0.01em; }
  .p-head p { margin: 4px 0 0; color: var(--s-muted); font-size: 12px; }
  .p-actions { display: flex; gap: 6px; }

  .presets { display: flex; gap: 8px; overflow-x: auto; padding: 12px 16px; border-bottom: 1px solid var(--s-line); scrollbar-width: none; }
  .preset { flex: none; display: grid; gap: 2px; width: 150px; text-align: left; padding: 10px 12px; border-radius: 10px; background: var(--s-elev); border: 1px solid var(--s-line); transition: border-color 0.2s, background 0.2s; }
  .preset:hover { border-color: #3a3a3a; }
  .preset[aria-pressed='true'] { border-color: #ededed; }
  .preset span { font-weight: 600; }
  .preset small { color: var(--s-muted); font-size: 11px; line-height: 1.35; }

  .groups { overflow-y: auto; overscroll-behavior: contain; padding-bottom: 24px; scrollbar-width: thin; scrollbar-color: #333 transparent; }
  .sec-title { margin: 0; padding: 18px 16px 6px; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--s-muted); }
  .sec + .sec { border-top: 1px solid var(--s-line); margin-top: 6px; }
  .group { border-bottom: 1px solid #1e1e1e; }
  .sec .group:last-child { border-bottom: 0; }
  .hour { display: none; grid-template-columns: 1fr auto; align-items: center; gap: 8px 10px; padding: 2px 20px 16px; color: var(--s-muted); font-size: 12px; }
  .hour label { grid-column: 1 / -1; display: flex; justify-content: space-between; }
  .hour output { color: var(--s-ink); font-variant-numeric: tabular-nums; }
  .hour input { accent-color: #ededed; width: 100%; }
  .group[data-group='ambient']:has(input[value='daylight']:checked) .hour { display: grid; }
  .group summary { display: flex; align-items: center; gap: 8px; padding: 13px 16px; cursor: pointer; list-style: none; user-select: none; }
  .group summary::-webkit-details-marker { display: none; }
  .group summary::before { content: ''; width: 6px; height: 6px; border-right: 1.5px solid var(--s-muted); border-bottom: 1.5px solid var(--s-muted); transform: rotate(-45deg); transition: transform 0.2s; margin-right: 4px; }
  .group[open] summary::before { transform: rotate(45deg) translate(-2px, -2px); }
  .g-label { font-weight: 600; }
  .g-value { margin-left: auto; color: var(--s-muted); }
  .g-try { margin-left: 6px; padding: 2px 8px; border-radius: 6px; background: #ededed; color: #0d0d0d; font-size: 11px; font-weight: 600; }
  .g-hint { margin: -4px 16px 10px 32px; color: var(--s-muted); font-size: 12px; }
  .opts { display: grid; gap: 2px; padding: 0 10px 14px; }
  .opt { position: relative; display: flex; gap: 10px; align-items: flex-start; padding: 8px 10px; border-radius: 8px; cursor: pointer; transition: background 0.15s; }
  .opt:hover { background: #1b1b1b; }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt:has(input:checked) { background: #222; box-shadow: inset 0 0 0 1px #3a3a3a; }
  .opt:has(input:focus-visible) { outline: 2px solid #8fa8ff; outline-offset: 1px; }
  .o-text { display: grid; gap: 1px; min-width: 0; }
  .o-name { font-weight: 550; }
  .opt:has(input:checked) .o-name::after { content: ' ✓'; color: #8fa8ff; }
  .o-note { color: var(--s-muted); font-size: 12px; }

  .opts--palette, .opts--type { grid-template-columns: 1fr 1fr; }
  .opts--palette .o-note, .opts--type .o-note { display: none; }
  .opts--palette .opt, .opts--type .opt { align-items: center; }
  .sw { display: grid; grid-template-columns: 1fr 1fr; width: 34px; height: 34px; border-radius: 8px; overflow: hidden; flex: none; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12); background: var(--a); }
  .sw i { display: block; }
  .sw i:nth-child(1) { background: var(--a); grid-row: span 2; }
  .sw i:nth-child(2) { background: var(--b); }
  .sw i:nth-child(3) { background: var(--c); }
  .spec { display: grid; place-items: center; width: 34px; height: 34px; flex: none; border-radius: 8px; background: #ededed; color: #0d0d0d; font-size: 19px; line-height: 1; }

  .p-foot { display: grid; gap: 8px; padding: 14px 16px calc(14px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--s-line); }
  .p-foot p { margin: 0; color: var(--s-muted); font-size: 12px; text-align: center; }

  .toast { position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 20px); opacity: 0; pointer-events: none; padding: 10px 14px; border-radius: 10px; background: #ededed; color: #0d0d0d; font-weight: 600; transition: opacity 0.25s, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); z-index: 10; }
  .toast[data-on] { opacity: 1; transform: translate(-50%, 0); }

  @media (max-width: 860px) {
    body { overflow: hidden; }
    .studio { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) 46dvh; }
    .bar { grid-template-columns: 1fr auto; height: 46px; }
    .seg, .bar [data-open-full] { display: none; }
    .panel { border-left: 0; border-top: 1px solid var(--s-line); grid-template-rows: auto auto minmax(0, 1fr) auto; }
    .p-head p { display: none; }
    .p-head { grid-template-columns: 1fr auto; align-items: center; padding: 10px 14px; }
    .presets { padding: 10px 14px; }
    .studio[data-device] .device { width: 100%; height: 100%; border-radius: 0; box-shadow: none; transform: none !important; }
  }
</style>
