---
import { Picture } from 'astro:assets';
import LabPreview from '../../../layouts/LabPreview.astro';
import { site } from '../../../site.config';
import portrait from '../../../assets/about/portrait-arms-crossed.jpg';
const education = [
  { when: '10/2022 – today', what: 'B.Sc. Computer Science and Design', where: 'Hochschule München' },
  { when: '10/2021 – 09/2022', what: 'B.Sc. Electrical Engineering and IT', where: 'Technical University of Munich' },
  { when: '09/2012 – 07/2021', what: 'Abitur', where: 'Rupprecht-Gymnasium München' },
];
---

<LabPreview title="About">
  <section class="ab wrap" data-section="About">
    <p class="lbl">About</p>
    <h1 class="d ab-title" data-rv>{site.name}</h1>
    <div class="ab-grid">
      <div class="ab-text">
        <p class="ab-lead" data-rv>I study Computer Science &amp; Design in Munich and approach design as a way to create work that feels considered and makes sense: how it looks, how it feels, how it flows and how it fits into its context.</p>
        <p>Alongside design, I am active in photography, videography and music production. These fields influence the way I think and push me to approach projects from different angles.</p>
        <p>I like working hands-on and trying things out, even without knowing exactly where they will lead. Even when something doesn’t work, it usually opens the door to something that does.</p>
      </div>
      <figure class="m ab-img"><Picture src={portrait} alt={`Portrait of ${site.name}`} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 800, 1100]} sizes="(min-width: 900px) 30vw, 100vw" class="fill" loading="eager" /></figure>
    </div>
  </section>
  <section class="ab wrap" data-section="Education">
    <h2 class="d ab-h" data-rv>Education</h2>
    <ol class="ab-tl" role="list">{education.map((e) => <li><span class="lbl tab">{e.when}</span><span class="ab-what">{e.what}</span><span class="ink-2">{e.where}</span></li>)}</ol>
  </section>
</LabPreview>

<style>
  .ab { padding-top: calc(var(--header-h) + clamp(48px, 8vw, 120px)); display: grid; gap: 16px; }
  .ab + .ab { padding-top: clamp(72px, 10vw, 140px); }
  .ab-title { font-size: var(--t-display); line-height: 0.88; }
  .ab-grid { margin-top: clamp(28px, 4vw, 56px); display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .ab-text { display: grid; gap: 1em; font-size: var(--t-md); max-width: 58ch; }
  .ab-lead { font-size: var(--t-lg); line-height: 1.3; letter-spacing: -0.015em; }
  .ab-img { aspect-ratio: 3 / 4; }
  .ab-h { font-size: var(--t-xl); }
  .ab-tl { border-top: 1px solid var(--line); }
  .ab-tl li { display: grid; grid-template-columns: minmax(130px, 1fr) 2fr 2fr; gap: 4px var(--gap); padding-block: 16px; border-bottom: 1px solid var(--line); align-items: baseline; }
  .ab-what { font-weight: 550; }
  @media (max-width: 900px) { .ab-grid { grid-template-columns: 1fr; } .ab-tl li { grid-template-columns: 1fr; } }
</style>
