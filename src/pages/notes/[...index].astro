---
/** The notes list. Built only when sections.notes is on in site.config.ts. */
import Site from '../../layouts/Site.astro';
import NotesContent from '../../components/site/NotesContent.astro';
import { site } from '../../site.config';

export function getStaticPaths() {
  return site.sections.notes ? [{ params: { index: undefined } }] : [];
}
---

<Site title="Notes" description={`Notes by ${site.name} on design, interaction and building things.`}>
  <NotesContent />
</Site>
