---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn’t exist." noindex>
  <section class="nf wrap">
    <p class="label">404</p>
    <h1>This page wandered off.</h1>
    <p class="muted">It may have moved, or the link has a typo.</p>
    <p class="actions"><a class="pill pill--solid" href="/">Go to the homepage</a></p>
  </section>
</Base>

<style>
  .nf { min-height: 80svh; display: grid; align-content: end; gap: 14px; padding-bottom: 48px; }
  h1 { font-size: var(--t-2xl); line-height: 0.95; letter-spacing: -0.045em; max-width: 12ch; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
