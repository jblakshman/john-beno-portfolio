---
import Site from '../layouts/Site.astro';
---

<Site title="Page not found" description="This page doesn’t exist." noindex>
  <section class="nf wrap">
    <p class="lbl">404</p>
    <h1 class="d" data-rv>This page wandered off.</h1>
    <p class="ink-2">It may have moved, or the link has a typo.</p>
    <p class="nf-actions"><a class="pill pill--solid" href="/">Go to the homepage</a> <a class="pill" href="/#work">See the work</a></p>
  </section>
</Site>

<style>
  .nf { min-height: 88svh; display: grid; align-content: end; gap: 16px; padding-bottom: max(48px, env(safe-area-inset-bottom, 0px)); }
  h1 { font-size: var(--t-display); line-height: 0.9; max-width: 11ch; }
  .nf-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
</style>
