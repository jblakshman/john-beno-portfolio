---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
import { breadcrumbs, graph, person } from '../../lib/schema';

const items = (await getCollection('playground', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const data = items.map((i) => ({
  slug: i.id,
  title: i.data.title,
  description: i.data.description,
  experiment: i.data.experiment,
  tags: i.data.tags,
  hue: i.data.hue,
  sound: i.data.sound,
}));
const jsonLd = graph(
  {
    '@type': 'CollectionPage',
    name: `Playground · ${site.name}`,
    url: `${site.url}/playground`,
    description: 'Interactive experiments and sketches built in code.',
    hasPart: items.map((i) => ({ '@type': 'CreativeWork', name: i.data.title, url: `${site.url}/playground/${i.id}`, description: i.data.description })),
  },
  person(),
  breadcrumbs([
    { name: site.name, url: `${site.url}/` },
    { name: 'Playground', url: `${site.url}/playground` },
  ]),
);
---

<Base
  title="Playground"
  description={`Playground of ${site.name}: interactive experiments with type, sound, motion and physics, built in code.`}
  forceDark
  footer={false}
  jsonLd={jsonLd}
>
  <section class="pg" data-pg>
    <h1 class="visually-hidden">Playground</h1>

    <div class="wall" data-wall tabindex="0" role="region" aria-label="Experiments canvas. Drag, scroll or use the arrow keys to explore." hidden>
      <div class="world" data-world></div>
    </div>

    <div class="hud wrap">
      <p class="label">Playground · {items.length} experiments</p>
      <p class="label hint" data-hint>Drag to explore</p>
      <div class="hud-actions">
        <button class="pill" type="button" data-view-toggle aria-pressed="false">List view</button>
      </div>
    </div>

    <div class="list wrap" data-list>
      <p class="label">Playground</p>
      <h2 class="list-title">Experiments, sketches and things that move.</h2>
      <ol role="list">
        {
          items.map((i, n) => (
            <li style={`--hue:${i.data.hue}`}>
              <a href={`/playground/${i.id}`} class="row">
                <span class="label tabular">{String(n + 1).padStart(2, '0')}</span>
                <span class="row-title">{i.data.title}</span>
                <span class="row-desc">{i.data.description}</span>
                <span class="row-tags">
                  {i.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="list-back"><a class="link" href="/">← Back to {site.name}</a> · <a class="link" href="/#contact">Contact</a></p>
    </div>

    <script type="application/json" id="pg-data" set:html={JSON.stringify(data)} />
  </section>
</Base>

<script>
  import '../../scripts/wall.ts';
</script>

<style>
  .pg {
    position: relative;
  }
  .wall {
    position: fixed;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in oklab, var(--ink) 14%, transparent) 1px, transparent 0) 0 0 / 28px 28px,
      var(--bg);
  }
  .wall[data-dragging] {
    cursor: grabbing;
  }
  .wall[data-dragging] :global(.tile) {
    pointer-events: none;
  }
  .world {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform;
  }
  .wall :global(.tile) {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color 0.3s var(--ease), box-shadow 0.4s var(--ease);
    animation: tile-in 0.7s var(--spring) both;
  }
  .wall :global(.tile:hover),
  .wall :global(.tile:focus-visible) {
    border-color: var(--hue);
    box-shadow: 0 0 0 1px var(--hue), 0 24px 60px -24px color-mix(in oklab, var(--hue) 55%, transparent);
  }
  @keyframes tile-in {
    from {
      scale: 0.86;
      opacity: 0;
    }
  }
  .wall :global(.tile-stage) {
    position: relative;
    flex: 1;
    overflow: hidden;
  }
  .wall :global(.tile-caption) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    padding: 10px 14px 12px;
    border-top: 1px solid var(--line);
  }
  .wall :global(.tile-title) {
    font-weight: 560;
    font-size: var(--t-sm);
  }
  .wall :global(.tile-title)::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hue);
    margin-right: 8px;
    vertical-align: 1px;
  }
  .wall :global(.tile--intro) {
    justify-content: space-between;
    padding: 18px;
    background: var(--ink);
    color: var(--bg);
    border-color: transparent;
  }
  .wall :global(.tile--intro h2) {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    font-weight: 620;
    font-variation-settings: 'wdth' 112;
  }
  .wall :global(.tile--intro p) {
    font-size: var(--t-sm);
    max-width: 30ch;
  }

  .hud {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: linear-gradient(to top, var(--bg) 20%, transparent);
    padding-top: 40px !important;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-bottom: max(14px, env(safe-area-inset-bottom, 0px));
    pointer-events: none;
  }
  .hud > * {
    pointer-events: auto;
  }
  .hud .pill {
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .hint {
    transition: opacity 0.6s var(--ease);
  }

  .list {
    padding-top: calc(var(--header-h) + clamp(48px, 8vw, 120px));
    padding-bottom: 120px;
  }
  .list[hidden] {
    display: none;
  }
  .list-title {
    margin: 12px 0 clamp(32px, 5vw, 64px);
    font-size: var(--t-2xl);
    line-height: 0.95;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }
  .list ol {
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 48px minmax(0, 3fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: 6px var(--gap);
    align-items: baseline;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
    transition: background 0.3s var(--ease), padding 0.4s var(--ease);
  }
  .row:hover {
    padding-inline: 12px;
    background: color-mix(in oklab, var(--hue) 12%, transparent);
  }
  .row-title {
    font-size: var(--t-lg);
    font-weight: 560;
    letter-spacing: -0.02em;
  }
  .row-desc {
    color: var(--ink-2);
  }
  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }
  .list-back {
    margin-top: 40px;
    font-size: var(--t-sm);
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .row {
      grid-template-columns: 36px minmax(0, 1fr);
    }
    .row-desc,
    .row-tags {
      grid-column: 2;
      justify-content: flex-start;
    }
    .hint {
      display: none;
    }
  }
</style>
