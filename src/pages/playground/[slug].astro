---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
import { breadcrumbs, graph, person, personId } from '../../lib/schema';

export async function getStaticPaths() {
  const items = (await getCollection('playground', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return items.map((item, i) => ({
    params: { slug: item.id },
    props: { item, prev: items[(i - 1 + items.length) % items.length], next: items[(i + 1) % items.length] },
  }));
}

const { item, prev, next } = Astro.props;
const d = item.data;
const { Content } = await render(item);
const url = `${site.url}/playground/${item.id}`;
const jsonLd = graph(
  {
    '@type': 'CreativeWork',
    name: d.title,
    description: d.description,
    url,
    author: { '@id': personId },
    keywords: d.tags.join(', '),
    isPartOf: { '@type': 'CollectionPage', name: 'Playground', url: `${site.url}/playground` },
  },
  person(),
  breadcrumbs([
    { name: site.name, url: `${site.url}/` },
    { name: 'Playground', url: `${site.url}/playground` },
    { name: d.title, url },
  ]),
);
---

<Base title={`${d.title} · Playground`} description={`${d.description} An interactive experiment by ${site.name}.`} forceDark jsonLd={jsonLd}>
  <section class="exp" style={`--hue:${d.hue}`}>
    <div class="exp-stage" data-experiment={d.experiment} data-mode="full"></div>
    <div class="exp-hud wrap">
      <a class="label link back" href="/playground">← Playground</a>
      <h1 class="exp-title">{d.title}</h1>
      <p class="exp-desc">{d.description}</p>
      <p class="label exp-how"><span class="dot" aria-hidden="true"></span>{d.interaction}</p>
    </div>
    <a class="scroll-cue label" href="#notes">Notes ↓</a>
  </section>

  <section class="notes wrap grid" id="notes" style={`--hue:${d.hue}`}>
    <p class="label notes-label">Notes</p>
    <div class="notes-body">
      <Content />
      <ul class="tags" role="list">
        {d.tags.map((t) => <li class="tag">{t}</li>)}
      </ul>
    </div>
    <nav class="pager" aria-label="More experiments">
      <a href={`/playground/${prev.id}`} class="pager-link">
        <span class="label">Previous</span>
        <span class="pager-title">{prev.data.title}</span>
      </a>
      <a href={`/playground/${next.id}`} class="pager-link pager-next">
        <span class="label">Next</span>
        <span class="pager-title">{next.data.title}</span>
      </a>
    </nav>
  </section>
</Base>

<script>
  import '../../scripts/experiments.ts';
</script>

<style>
  .exp {
    position: relative;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in oklab, var(--ink) 10%, transparent) 1px, transparent 0) 0 0 / 28px 28px,
      var(--bg);
  }
  .exp-stage {
    position: absolute;
    inset: 0;
  }
  .exp::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    width: min(760px, 100%);
    height: 420px;
    background: radial-gradient(ellipse 70% 70% at 0 0, var(--bg) 35%, transparent 100%);
    pointer-events: none;
  }
  .exp-hud {
    position: absolute;
    top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + 20px);
    left: 0;
    display: grid;
    gap: 10px;
    max-width: min(440px, 100%);
    pointer-events: none;
    z-index: 2;
  }
  .exp-hud a {
    pointer-events: auto;
    justify-self: start;
  }
  .exp-title {
    font-size: var(--t-xl);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: 600;
    font-variation-settings: 'wdth' 110;
  }
  .exp-desc {
    color: var(--ink-2);
    max-width: 34ch;
  }
  .exp-how {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--ink);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hue);
    box-shadow: 0 0 12px var(--hue);
    flex: none;
  }
  .scroll-cue {
    position: absolute;
    right: max(var(--gutter), env(safe-area-inset-right, 0px));
    bottom: max(18px, env(safe-area-inset-bottom, 0px));
  }
  .notes {
    padding-top: clamp(56px, 8vw, 112px);
    row-gap: 24px;
  }
  .notes-label {
    grid-column: 1 / span 3;
  }
  .notes-body {
    grid-column: 4 / span 6;
    display: grid;
    gap: 1em;
    font-size: var(--t-md);
    max-width: 62ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .pager {
    grid-column: 1 / -1;
    margin-top: clamp(48px, 7vw, 96px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
  }
  .pager-link {
    display: grid;
    gap: 6px;
    padding-top: 18px;
  }
  .pager-next {
    text-align: right;
  }
  .pager-title {
    font-size: var(--t-lg);
    font-weight: 560;
    letter-spacing: -0.02em;
    transition: color 0.25s var(--ease);
  }
  .pager-link:hover .pager-title {
    color: var(--hue);
  }
  @media (max-width: 900px) {
    .notes-label,
    .notes-body {
      grid-column: 1 / -1;
    }
  }
</style>
