---
import Site from '../layouts/Site.astro';
import AboutContent from '../components/site/AboutContent.astro';
import { aboutGraph } from '../lib/schema';
import { site } from '../site.config';
---

<Site
  title="About"
  description={`About ${site.name}: a computer science and design student in Munich who works across UX/UI, interaction, photography, video and music.`}
  ogType="profile"
  jsonLd={await aboutGraph()}
>
  <AboutContent />
</Site>
