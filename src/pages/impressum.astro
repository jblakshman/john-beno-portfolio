---
import Site from '../layouts/Site.astro';
import { site } from '../site.config';

const address = site.legal.address as readonly string[];
if (!address.length) {
  console.warn('\n⚠️  Impressum: no postal address set in src/site.config.ts (legal.address). Add one before launch.\n');
}
---

<Site title="Impressum" description={`Legal notice (Impressum) for ${site.url.replace('https://', '')}.`} noindex>
  <article class="doc wrap">
    <p class="lbl">Legal notice</p>
    <h1 class="d">Impressum</h1>
    <p class="lbl">Information according to § 5 DDG (Digitale-Dienste-Gesetz)</p>

    <h2>Responsible for this website</h2>
    <p>
      {site.name}<br />
      {address.length ? address.map((line) => <>{line}<br /></>) : <span class="todo">Postal address required before launch</span>}
    </p>

    <h2>Contact</h2>
    <p>
      Email: <a class="ln" href={`mailto:${site.email}`}>{site.email}</a>
      {site.phone && <><br />Phone: {site.phone}</>}
    </p>

    <h2>Responsible for content according to § 18 (2) MStV</h2>
    <p>{site.name}, address as above.</p>

    <h2>Liability for links</h2>
    <p>
      This website contains links to external websites. I have no influence on their content and accept no liability for it. The respective provider
      or operator of a linked page is always responsible for its content. If I become aware of any legal violations, I will remove such links
      immediately.
    </p>

    <h2>Copyright</h2>
    <p>
      All texts, images, videos and designs on this website are my own work unless stated otherwise and may not be used without permission.
      Brand names such as Orient and Apple belong to their respective owners; the projects shown are student concepts and are not affiliated with
      those companies.
    </p>
  </article>
</Site>

