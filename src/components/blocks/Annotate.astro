---
/**
 * An image with numbered notes. Place each marker with x and y in percent
 * of the image (0,0 is the top left). Hovering a note shows its marker.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { dataW, fit, imageSizes, type Width } from './width';
import '../../styles/site/blocks.css';

interface Props {
  src: ImageMetadata;
  alt: string;
  notes: { x: number; y: number; title: string; text?: string }[];
  caption?: string;
  w?: Width;
  frame?: 'none' | 'mat';
}
const { src, alt, notes, caption, w = 'column', frame = 'mat' } = Astro.props;
const s = imageSizes[w];
---

<figure class:list={['blk fig ann', `fig--${frame}`]} data-w={dataW(w)} data-nogl data-annotate>
  <div class="fig-m ann-m">
    <div class="ann-img">
      <Picture src={src} alt={alt} formats={['avif', 'webp']} fallbackFormat={src.format === 'png' ? 'png' : 'jpg'} widths={fit(s.widths, src.width)} sizes={s.sizes} loading="lazy" />
      {notes.map((n, i) => <span class="ann-dot tab" style={`left:${n.x}%;top:${n.y}%`} data-k={i} aria-hidden="true">{i + 1}</span>)}
    </div>
  </div>
  <ol class="ann-notes" role="list">
    {
      notes.map((n, i) => (
        <li data-k={i} tabindex="0">
          <span class="ann-n tab" aria-hidden="true">{i + 1}</span>
          <span><strong>{n.title}</strong>{n.text && <span class="ink-2"> {n.text}</span>}</span>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import '../../design/blocks.ts';
</script>
