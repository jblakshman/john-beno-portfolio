---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  poster: ImageMetadata;
  caption?: string;
  controls?: boolean;
  /** Muted, looping, plays while visible (unless the visitor prefers reduced motion). */
  autoplay?: boolean;
  loop?: boolean;
}
const { src, poster, caption, controls = false, autoplay = false, loop = false } = Astro.props;
const posterImg = await getImage({ src: poster, width: 1600, format: 'webp', quality: 80 });
---

<figure class="figure video">
  <div class="frame" style={`aspect-ratio:${poster.width}/${poster.height}`}>
    <video
      src={src}
      poster={posterImg.src}
      muted
      playsinline
      preload="metadata"
      controls={controls || undefined}
      loop={loop || undefined}
      data-autoplay={autoplay ? '' : undefined}
      width={poster.width}
      height={poster.height}
    ></video>
  </div>
  {caption && <figcaption class="label">{caption}</figcaption>}
</figure>

<style>
  .figure {
    display: grid;
    gap: 10px;
    margin-block: clamp(28px, 4vw, 48px);
  }
  .figure figcaption {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: var(--t-xs);
  }
</style>
