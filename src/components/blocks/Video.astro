---
/**
 * A video. Loops silently while visible (autoplay), or plays with controls.
 * Encode with: npm run media -- web path/to/video.mov
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { dataW, type Width } from './width';
import '../../styles/site/blocks.css';

interface Props {
  src: string;
  poster: ImageMetadata;
  caption?: string;
  /** Describes the video for screen readers when it has no caption. */
  label?: string;
  w?: Width;
  frame?: 'none' | 'mat' | 'phone' | 'browser';
  /** Muted, looping, plays while visible (unless the visitor prefers reduced motion). */
  autoplay?: boolean;
  controls?: boolean;
  loop?: boolean;
}
const { src, poster, caption, label, w = 'column', frame = 'none', autoplay = false, controls = !autoplay, loop = autoplay } = Astro.props;
const posterImg = await getImage({ src: poster, width: Math.min(poster.width, 1800), format: 'webp', quality: 78 });
---

<figure class:list={['blk fig', `fig--${frame}`]} data-w={dataW(w)} data-nogl>
  <div class="fig-m" style={`aspect-ratio:${poster.width}/${poster.height}`}>
    {frame === 'browser' && <span class="fig-bar" aria-hidden="true"><i></i><i></i><i></i></span>}
    <video
      src={src}
      poster={posterImg.src}
      muted
      playsinline
      preload={autoplay ? 'none' : 'metadata'}
      controls={controls || undefined}
      loop={loop || undefined}
      data-autoplay={autoplay ? '' : undefined}
      aria-label={label ?? caption}
      width={poster.width}
      height={poster.height}
    ></video>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
