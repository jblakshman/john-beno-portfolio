---
/**
 * An image with an optional caption.
 * <Figure src={img} alt="…" caption="…" w="wide" frame="mat" />
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { dataW, fit, imageSizes, type Width } from './width';
import '../../styles/site/blocks.css';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** text, column (default), wide or full */
  w?: Width;
  /** mat: the image sits on a soft surface, good for UI screens. phone / browser: a light device frame. */
  frame?: 'none' | 'mat' | 'phone' | 'browser';
  /** Crop to an aspect ratio, e.g. "16/9". */
  ratio?: string;
  loading?: 'lazy' | 'eager';
}
const { src, alt, caption, w = 'column', frame = 'none', ratio, loading = 'lazy' } = Astro.props;
const s = imageSizes[w];
---

<figure class:list={['blk fig', `fig--${frame}`]} data-w={dataW(w)}>
  <div class="fig-m" style={ratio ? `aspect-ratio:${ratio}` : undefined}>
    {frame === 'browser' && <span class="fig-bar" aria-hidden="true"><i></i><i></i><i></i></span>}
    <Picture src={src} alt={alt} formats={['avif', 'webp']} fallbackFormat={src.format === 'png' ? 'png' : 'jpg'} widths={fit(s.widths, src.width)} sizes={s.sizes} loading={loading} decoding="async" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
