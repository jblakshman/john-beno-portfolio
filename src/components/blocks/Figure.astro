---
/**
 * An image with an optional caption.
 * <Figure src={img} alt="…" caption="…" w="wide" frame="mat" />
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { dataW, fit, imageSizes, type Width } from './width';
import '../../styles/site/blocks.css';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** text, column (default), wide or full */
  w?: Width;
  /** mat: the image sits on a soft surface, good for UI screens. phone / browser: a light device frame. */
  frame?: 'none' | 'mat' | 'phone' | 'browser';
  /** Crop to an aspect ratio, e.g. "16/9". */
  ratio?: string;
  loading?: 'lazy' | 'eager';
  /** Click to see the image large. On by default, except for full-width images. */
  zoom?: boolean;
}
const { src, alt, caption, w = 'column', frame = 'none', ratio, loading = 'lazy', zoom = w !== 'full' } = Astro.props;
const s = imageSizes[w];
const large = zoom ? (await getImage({ src, width: Math.min(src.width, 2400), format: 'webp', quality: 82 })).src : undefined;
---

<figure class:list={['blk fig', `fig--${frame}`]} data-w={dataW(w)} data-zoom={large} data-cur={zoom ? 'Zoom' : undefined}>
  <div class="fig-m" style={ratio ? `aspect-ratio:${ratio}` : undefined}>
    {zoom && <button type="button" class="fig-zoom" aria-label={`Enlarge image: ${alt}`}></button>}
    {frame === 'browser' && <span class="fig-bar" aria-hidden="true"><i></i><i></i><i></i></span>}
    <Picture src={src} alt={alt} formats={['avif', 'webp']} fallbackFormat={src.format === 'png' ? 'png' : 'jpg'} widths={fit(s.widths, src.width)} sizes={s.sizes} loading={loading} decoding="async" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import '../../design/blocks.ts';
</script>
