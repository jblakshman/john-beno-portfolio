---
import { Image, Picture } from 'astro:assets';
import { site } from '../../site.config';
import portrait from '../../assets/about/portrait-standing.jpg';
import portraitTall from '../../assets/about/portrait-arms-crossed.jpg';
const meta = [
  { k: 'Role', v: site.role },
  { k: 'Studying', v: 'Computer Science & Design, Hochschule München' },
  { k: 'Also into', v: 'Photography, videography, music production' },
  { k: 'Based in', v: `${site.location.city}, ${site.location.countryName}` },
];
import { variantOf } from '../../design/variant';
import { paths } from '../../design/paths';
const v = variantOf(paths(Astro.url).preview);
---

<!-- Statement -->
  {v('hero', 'statement') && (
<section class="H H-statement wrap" aria-label="Introduction">
  <h1 class="d hs-title" data-rv>
    {site.name}
    <span class="hs-chip" aria-hidden="true"><Image src={portrait} alt="" width={180} height={180} fit="cover" position="top" loading="eager" /></span>
    <span class="hs-rest">designs digital things that feel thoughtful, honest and well&#8209;crafted.</span>
  </h1>
  <dl class="hmeta grid">
    {meta.map((m) => <div><dt class="lbl">{m.k}</dt><dd>{m.v}</dd></div>)}
  </dl>
</section>
  )}

<!-- Giant name -->
  {v('hero', 'giant') && (
<section class="H H-giant wrap" aria-label="Introduction">
  <div class="hg-top">
    <p class="lbl">{site.role}</p>
    <p class="lbl">{site.location.city} · <time data-clock class="tab">--:--</time></p>
  </div>
  <h1 class="d hg-name" data-fit data-rv>{site.name}</h1>
  <div class="hg-bottom grid">
    <p class="hg-intro">A computer science and design student in Munich, making digital things that feel thoughtful, honest and well-crafted.</p>
    <dl class="hg-meta">{meta.slice(1, 3).map((m) => <div><dt class="lbl">{m.k}</dt><dd>{m.v}</dd></div>)}</dl>
  </div>
</section>
  )}

<!-- Portrait -->
  {v('hero', 'split') && (
<section class="H H-split wrap grid" aria-label="Introduction">
  <div class="hp-text">
    <p class="lbl">{site.role}</p>
    <h1 class="d hp-title" data-rv>{site.name}</h1>
    <p class="hp-intro">I study Computer Science &amp; Design in Munich and make digital products that feel considered: how they look, how they move, and how they fit into people’s lives.</p>
    <dl class="hp-meta">{meta.slice(1).map((m) => <div><dt class="lbl">{m.k}</dt><dd>{m.v}</dd></div>)}</dl>
  </div>
  <figure class="hp-img m">
    <Picture src={portraitTall} alt={`Portrait of ${site.name}`} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 800, 1100]} sizes="(min-width: 900px) 38vw, 100vw" class="fill" loading="eager" />
  </figure>
</section>
  )}

<!-- Minimal -->
  {v('hero', 'minimal') && (
<section class="H H-minimal wrap" aria-label="Introduction">
  <div class="hm-col">
    <h1 class="hm-name" data-rv>{site.name}</h1>
    <p class="hm-role muted">{site.role}</p>
    <p class="hm-text">Computer science and design student in Munich. I care about clarity, emotion and the small details that bring balance and purpose to a design. Alongside it, I make photographs, videos and music.</p>
  </div>
</section>
  )}

<!-- Typeset -->
  {v('hero', 'typeset') && (
<section class="H H-typeset wrap" aria-label="Introduction">
  <h1 class="d ht-title" data-rv>
    <span class="ht-l">{site.name}</span>
    <span class="ht-l ht-i1">is a designer</span>
    <span class="ht-l">and design engineer</span>
    <span class="ht-l ht-i2">in Munich.</span>
  </h1>
  <p class="ht-note lbl">Computer Science &amp; Design · Hochschule München · <time data-clock class="tab">--:--</time></p>
</section>
  )}
