---
/**
 * A case study page. The header comes in three styles (classic, cinematic,
 * editorial) and the design config picks one. The body is the project's MDX.
 */
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import { paths } from '../../design/paths';
import { facts, readingTime, sortedLinks, type Project } from '../../lib/work';
import { onLoaded, placeholderStyle } from '../../lib/placeholder';

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const P = paths(Astro.url);
const d = project.data;
const { Content, headings } = await render(project);
const sections = headings.filter((h) => h.depth === 2);
const rows = facts(d);
const links = sortedLinks(d);
const ph = await placeholderStyle(d.cover);
const vt = `--vt: w-${project.id};${ph}`;
const nextPh = next ? await placeholderStyle(next.data.cover) : '';
const pic = (sizes: string, cls = 'fill') => ({
  src: d.cover,
  alt: d.coverAlt,
  formats: ['avif', 'webp'] as ('avif' | 'webp')[],
  fallbackFormat: 'jpg' as const,
  widths: [800, 1200, 1600, 2200],
  sizes,
  loading: 'eager' as const,
  fetchpriority: 'high' as const,
  onload: onLoaded,
  class: cls,
});
const inProgress = d.status === 'in-progress';
const minutes = readingTime(project.body);
const share = { 'data-share': '', 'data-share-title': `${d.title} · John Beno Lakshman` };
const ext = { target: '_blank', rel: 'noopener' };
import { variantOf } from '../../design/variant';
const v = variantOf(P.preview);
---

<article class="case" data-section={d.title}>
  <!-- Classic -->
  {v('case', 'classic') && (
  <header class="C C-classic wrap">
    <nav class="lbl crumbs" aria-label="Breadcrumb">
      <a class="ln" href={P.work}>Work</a> / <span class="lbl--ink" aria-current="page">{d.title}</span>
      {inProgress && <span class="status">In progress</span>}
      {d.draft && <span class="status status--draft">Draft</span>}
      {P.preview && d.unlisted && <span class="status status--draft">Unlisted</span>}
      <span class="crumbs-end"><span class="tab">{minutes} min read</span> · <button type="button" class="ln" {...share}>Share</button></span>
    </nav>
    <h1 class="d cc-title" data-rv>{d.title}</h1>
    <p class="cc-sum ink-2">{d.summary}</p>
    <dl class="cmeta grid">
      {rows.map((m) => <div><dt class="lbl">{m.k}</dt><dd>{m.v}</dd></div>)}
      <div>
        <dt class="lbl">{links.length > 1 ? 'Links' : 'Link'}</dt>
        <dd class="links">
          {links.length ? links.map((l) => <a class="ln" href={l.url} {...ext}>{l.label} ↗</a>) : <span class="muted">{inProgress ? 'Coming soon' : '—'}</span>}
        </dd>
      </div>
    </dl>
    <div class="m cc-hero" data-vt data-ph style={vt}><Picture {...pic('100vw')} /></div>
  </header>
  )}

  <!-- Cinematic -->
  {v('case', 'cinematic') && (
  <header class="C C-cinematic">
    <div class="m ci-hero" data-vt data-ph style={vt}><Picture {...pic('100vw')} /></div>
    <div class="ci-over wrap">
      <p class="lbl">{d.context}{inProgress && ' · In progress'} · {minutes} min read · <button type="button" class="ln" {...share}>Share</button></p>
      <h1 class="d ci-title" data-rv>{d.title}</h1>
    </div>
    <div class="ci-below wrap grid">
      <p class="ci-sum">{d.summary}</p>
      <dl class="ci-meta">
        {rows.map((m) => <div><dt class="lbl">{m.k}</dt><dd>{m.v}</dd></div>)}
        {links.length > 0 && <div><dt class="lbl">{links.length > 1 ? 'Links' : 'Link'}</dt><dd class="links">{links.map((l) => <a class="ln" href={l.url} {...ext}>{l.label} ↗</a>)}</dd></div>}
      </dl>
    </div>
  </header>
  )}

  <!-- Editorial -->
  {v('case', 'editorial') && (
  <header class="C C-editorial wrap">
    <p class="lbl ce-kicker">{d.context} · {d.role ?? d.disciplines.join(', ')} · {minutes} min read · <button type="button" class="ln" {...share}>Share</button></p>
    <h1 class="d ce-title" data-rv>{d.title}</h1>
    <p class="ce-sum">{d.summary}</p>
    <div class="m ce-hero" data-vt data-ph style={vt}><Picture {...pic('(min-width: 900px) 80vw, 100vw')} /></div>
    <p class="lbl ce-credit">
      {[d.period ?? d.year, d.tools.join(', ')].filter(Boolean).join(' · ')}
      {links.map((l) => <> · <a class="ln" href={l.url} {...ext}>{l.label} ↗</a></>)}
    </p>
  </header>
  )}

  {
    d.glance && (
      <section class="glance wrap grid" aria-labelledby="glance-title">
        <h2 class="lbl glance-h" id="glance-title">At a glance</h2>
        <dl class="glance-l">
          <div><dt class="lbl">Challenge</dt><dd>{d.glance.challenge}</dd></div>
          <div><dt class="lbl">Approach</dt><dd>{d.glance.approach}</dd></div>
          <div><dt class="lbl">Outcome</dt><dd>{d.glance.outcome}</dd></div>
        </dl>
      </section>
    )
  }

  <div class="case-body">
    {
      sections.length > 1 && (
        <aside class="case-toc" aria-label="On this page">
          <div class="toc-in">
            <p class="lbl">Contents</p>
            <ol role="list">{sections.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
          </div>
        </aside>
      )
    }
    <div class="prose"><Content /></div>
  </div>

  {
    d.credits.length > 0 && (
      <section class="credits wrap grid" aria-labelledby="credits-title">
        <h2 class="lbl" id="credits-title">Credits</h2>
        <ul role="list">
          {d.credits.map((c) => (
            <li>
              <span class="ink-2">{c.role}</span>
              {c.url ? <a class="ln" href={c.url} {...ext}>{c.name}</a> : <span>{c.name}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</article>

{
  next && next.id !== project.id && (
    <nav class="next wrap" aria-label="Next project">
      <a class="next-a grid p" href={P.project(next.id)} data-cur="Next project">
        <span class="next-t">
          <span class="lbl">Next project</span>
          <span class="d next-title">{next.data.title} →</span>
          <span class="ink-2">{next.data.summary}</span>
        </span>
        <span class="m next-m" data-vt data-ph style={`--vt: w-${next.id};${nextPh}`}>
          <Picture src={next.data.cover} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[640, 960, 1280]} sizes="40vw" class="fill" onload={onLoaded} />
        </span>
      </a>
    </nav>
  )
}
