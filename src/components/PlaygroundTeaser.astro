---
import { getCollection } from 'astro:content';
const count = (await getCollection('playground', ({ data }) => !data.draft)).length;
---

<section class="teaser wrap" aria-labelledby="pg-title">
  <a class="card force-dark" href="/playground" data-cursor="Enter the playground">
    <div class="text">
      <p class="label">Playground · {count} experiments</p>
      <h2 id="pg-title">Experiments, sketches and things that move.</h2>
      <p class="sub">Less polish, more play. Small interactive studies, built in code.</p>
      <span class="pill pill--solid">Enter the playground <span class="arrow" aria-hidden="true">→</span></span>
    </div>
    <div class="stage" data-experiment="pin-table" data-mode="tile" style="--hue:#ff6a3d" aria-hidden="true"></div>
  </a>
</section>

<script>
  import '../scripts/experiments.ts';
</script>

<style>
  .teaser {
    margin-top: clamp(96px, 12vw, 180px);
  }
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    min-height: clamp(360px, 42vw, 560px);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
  }
  .text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(20px, 3vw, 40px);
    pointer-events: none;
  }
  .text h2 {
    font-size: var(--t-xl);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 560;
    max-width: 12ch;
  }
  .sub {
    color: var(--ink-2);
    max-width: 32ch;
  }
  .text .pill {
    align-self: flex-start;
    background: var(--ink);
    color: var(--bg);
  }
  .card:hover .pill {
    background: #ff6a3d;
    border-color: #ff6a3d;
    color: #0c0c0b;
  }
  .stage {
    position: relative;
    min-height: 280px;
  }
  @media (max-width: 760px) {
    .card {
      grid-template-columns: 1fr;
    }
    .stage {
      order: -1;
      height: 280px;
    }
  }
</style>
