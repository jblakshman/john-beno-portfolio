---
import { site } from '../../site.config';
const base = '/lab/p';
const links = [
  { href: `${base}#work`, label: 'Work', n: '01' },
  { href: `${base}/about`, label: 'About', n: '02' },
  { href: `${base}/apps`, label: 'Apps', n: '03' },
  { href: '#contact', label: 'Contact', n: '04' },
];
const path = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => (href.includes('#') ? false : path === href);
---

<!-- Every navigation style is rendered; the configuration decides which one shows. -->
<header class="site-nav">
  <!-- Bar -->
  <div class="nv nv--bar wrap">
    <a class="nv-name ln" href={base}>{site.name}</a>
    <nav aria-label="Main"><ul role="list">{links.map((l) => <li><a class="ln" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}</ul></nav>
    <span class="lbl nv-time">{site.location.city} <time data-clock class="tab">--:--</time></span>
    <button class="crn-btn nv-mbtn" type="button" data-menu-open aria-expanded="false" aria-controls="lab-menu"><span class="ln">Menu</span></button>
  </div>

  <!-- Island -->
  <div class="nv nv--island">
    <div class="isl" data-island>
      <a class="isl-name" href={base}><span class="isl-dot" aria-hidden="true"></span><span>{site.shortName}</span></a>
      <span class="isl-now lbl" data-island-now aria-hidden="true">Home</span>
      <nav class="isl-links" aria-label="Main"><ul role="list">{links.map((l) => <li><a class="ln" href={l.href}>{l.label}</a></li>)}</ul></nav>
    </div>
  </div>

  <!-- Side index -->
  <div class="nv nv--index">
    <a class="nv-name ln" href={base}>{site.name}</a>
    <nav aria-label="Main"><ol role="list">{links.map((l) => <li><a class="ln" href={l.href} data-index-link={l.href.split('#')[1] ?? ''}><span class="lbl tab">{l.n}</span> {l.label}</a></li>)}</ol></nav>
  </div>

  <!-- Corners -->
  <div class="nv nv--corner wrap">
    <a class="nv-name ln" href={base}>{site.name}</a>
    <button class="crn-btn" type="button" data-menu-open aria-expanded="false" aria-controls="lab-menu"><span class="ln">Menu</span></button>
  </div>

</header>

<div class="menu" id="lab-menu" hidden>
  <div class="menu-in wrap">
    <div class="menu-top">
      <span class="lbl">Menu</span>
      <button class="crn-btn" type="button" data-menu-close><span class="ln">Close</span></button>
    </div>
    <nav aria-label="Menu"><ol role="list">{links.map((l, i) => <li style={`--i:${i}`}><a class="d ln" href={l.href} data-menu-link>{l.label}</a></li>)}</ol></nav>
    <p class="lbl">{site.email} · {site.location.city}, {site.location.countryName}</p>
  </div>
</div>
