---
import { site } from '../site.config';
const year = new Date().getFullYear();
const letters = [...site.name];
---

<footer class="site-footer wrap" id="contact">
  <div class="footer-top grid">
    <p class="label footer-label">Contact</p>
    <div class="footer-main">
      <h2 class="footer-hello">Good ideas often begin with a simple hello.</h2>
      <div class="email-row">
        <a class="email link link--under" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="pill copy" type="button" data-copy={site.email}>
          <span data-copy-label>Copy email</span>
        </button>
      </div>
      {site.phone && <a class="phone link" href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a>}
    </div>
    <ul class="footer-links" role="list">
      {
        site.profiles.map((p) => (
          <li>
            <a class="link" href={p.url} rel="me noopener" target="_blank">
              {p.label} <span class="arrow arrow--ne" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="link" href={site.cv} target="_blank" rel="noopener">CV (PDF) <span class="arrow arrow--ne" aria-hidden="true">↗</span></a>
      </li>
    </ul>
  </div>

  <p class="motto">{site.tagline}</p>

  <div class="wordmark-wrap" aria-hidden="true">
    <div class="wordmark" data-wordmark>
      {letters.map((ch) => (ch === ' ' ? <span class="sp"> </span> : <span>{ch}</span>))}
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {year} {site.name}</p>
    <ul role="list">
      <li><a class="link" href="/impressum">Impressum</a></li>
      <li><a class="link" href="/privacy">Privacy</a></li>
      <li><a class="link" href="#main" data-to-top>Back to top ↑</a></li>
    </ul>
    <p class="label">{site.location.city}, {site.location.countryName} · <time data-clock class="tabular">--:--</time></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(96px, 14vw, 200px);
    padding-top: 28px;
    padding-bottom: max(20px, env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
    overflow: clip;
  }
  .footer-top {
    row-gap: 28px;
    align-items: start;
  }
  .footer-label {
    grid-column: 1 / span 3;
  }
  .footer-main {
    grid-column: 4 / span 6;
    display: grid;
    gap: 22px;
    min-width: 0;
  }
  .footer-hello {
    font-size: var(--t-xl);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 540;
    max-width: 14ch;
  }
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .email {
    font-size: var(--t-lg);
    font-weight: 500;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .copy[data-copied] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .footer-links {
    grid-column: 10 / span 3;
    display: grid;
    gap: 6px;
    justify-items: start;
    font-size: var(--t-sm);
  }
  .motto {
    margin-top: clamp(56px, 8vw, 112px);
    max-width: 44ch;
    color: var(--ink-2);
    font-size: var(--t-sm);
  }
  .wordmark-wrap {
    margin-top: 20px;
    overflow: clip;
  }
  .wordmark {
    display: inline-flex;
    white-space: nowrap;
    font-size: var(--wm-size, 10.4vw);
    line-height: 0.82;
    letter-spacing: -0.045em;
    font-weight: 600;
    font-variation-settings: 'wdth' 100;
    user-select: none;
    color: var(--ink);
    padding-bottom: 0.05em;
  }
  .wordmark span {
    display: inline-block;
    font-variation-settings: 'wdth' var(--w, 100), 'wght' var(--g, 600);
    font-weight: var(--g, 600);
    transition: font-variation-settings 0.5s var(--ease);
  }
  .wordmark .sp {
    width: 0.22em;
  }
  .footer-bottom {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 24px;
    font-size: var(--t-xs);
    color: var(--ink-2);
  }
  .footer-bottom ul {
    display: flex;
    gap: 18px;
  }
  @media (max-width: 900px) {
    .footer-label {
      grid-column: 1 / -1;
    }
    .footer-main {
      grid-column: 1 / -1;
    }
    .footer-links {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: 8px 20px;
    }
  }
</style>
