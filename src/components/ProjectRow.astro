---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const d = project.data;
const href = `/work/${project.id}`;
---

<article class="project grid" data-cursor={d.status === 'in-progress' ? 'Preview' : 'View case study'}>
  <div class="project-meta">
    <p class="label">{d.context}</p>
    <h3 class="project-title"><a href={href} class="stretch">{d.title}</a></h3>
    <p class="project-summary">{d.summary}</p>
    <ul class="project-tags" role="list">
      {d.disciplines.map((t) => <li class="tag">{t}</li>)}
    </ul>
    <span class="project-cta" aria-hidden="true">
      {d.status === 'in-progress' ? 'Preview case study' : 'View case study'} <span class="arrow">→</span>
    </span>
  </div>

  <a href={href} class="project-media frame" tabindex="-1" aria-hidden="true" style={`view-transition-name: work-${project.id}`}>
    <Picture
      src={d.cover}
      alt=""
      formats={['avif', 'webp']} fallbackFormat="jpg"
      widths={[640, 960, 1280, 1800]}
      sizes="(min-width: 900px) 64vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
    {
      d.previewVideo && (
        <video class="project-preview" data-src={d.previewVideo} muted loop playsinline preload="none" aria-hidden="true" />
      )
    }
    {d.status === 'in-progress' && <span class="badge label">Case study in progress</span>}
  </a>
</article>

<style>
  .project {
    position: relative;
    padding-block: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--line);
    row-gap: 20px;
  }
  .project-meta {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 28px);
  }
  .project-title {
    font-size: var(--t-xl);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 560;
  }
  .project-summary {
    color: var(--ink-2);
    max-width: 36ch;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .project-cta {
    margin-top: 6px;
    font-size: var(--t-sm);
    font-weight: 500;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .project-media {
    grid-column: 5 / -1;
    aspect-ratio: 3 / 2;
    display: block;
  }
  .project-media :global(img),
  .project-preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease), opacity 0.5s var(--ease);
  }
  .project-preview {
    opacity: 0;
  }
  .project:hover .project-media :global(img) {
    transform: scale(1.025);
  }
  .project:hover .project-preview[data-ready] {
    opacity: 1;
  }
  .badge {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 2;
    padding: 6px 10px;
    border-radius: 999px;
    color: #f2f1ed;
    background: rgb(12 12 11 / 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .project:hover .project-cta .arrow {
    transform: translateX(4px);
  }
  .project:focus-within .project-media {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (max-width: 900px) {
    .project-meta {
      grid-column: 1 / -1;
      position: static;
    }
    .project-media {
      grid-column: 1 / -1;
      order: -1;
    }
  }
</style>
