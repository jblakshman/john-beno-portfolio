---
import { site } from '../site.config';

const { contactHref = '#contact' } = Astro.props as { contactHref?: string };
const path = Astro.url.pathname.replace(/\.html$/, '');
const nav = [
  { href: '/#work', label: 'Work', match: (p: string) => p.startsWith('/work') },
  { href: '/about', label: 'About', match: (p: string) => p.startsWith('/about') },
  { href: contactHref, label: 'Contact', match: () => false },
];
---

<header class="site-header wrap">
  <a class="brand" href="/" aria-label={`${site.name}, home`}>
    <span class="brand-name">{site.name}</span>
  </a>

  <nav class="nav" aria-label="Main">
    <ul role="list">
      {
        nav.map((item) => (
          <li>
            <a class="nav-link" href={item.href} aria-current={item.match(path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="header-meta">
    <span class="clock label" aria-label={`Local time in ${site.location.city}`}>
      {site.location.city} <time data-clock class="tabular">--:--</time>
    </span>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <circle cx="9" cy="9" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M9 1.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
      </svg>
    </button>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="menu-bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <ul role="list">
    {
      nav.map((item, i) => (
        <li style={`--i:${i}`}>
          <a href={item.href} data-menu-link>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="label">{site.location.city} · <time data-clock class="tabular">--:--</time></p>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: calc(var(--header-h) + env(safe-area-inset-top, 0px));
    padding-top: env(safe-area-inset-top, 0px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gap);
    font-size: var(--t-sm);
    font-weight: 500;
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  :global(html.scrolled) .site-header {
    border-bottom-color: var(--line);
  }
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    letter-spacing: -0.005em;
  }
  .brand-name {
    font-weight: 600;
  }
  .nav ul {
    display: flex;
    gap: 4px;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    color: var(--ink-2);
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--bg-elev);
  }
  .nav-link[aria-current='page'] {
    color: var(--ink);
  }
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--accent);
  }
  .header-meta {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .clock {
    white-space: nowrap;
  }
  .clock time {
    color: var(--ink);
  }
  .theme-toggle,
  .menu-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    transition: background 0.2s var(--ease), transform 0.4s var(--spring);
  }
  .theme-toggle:hover,
  .menu-toggle:hover {
    background: var(--bg-elev);
  }
  .theme-toggle:active {
    transform: rotate(180deg) scale(0.92);
  }
  .menu-toggle {
    display: none;
  }
  .menu-bars {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .menu-bars i {
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.35s var(--ease);
  }
  .menu-toggle[aria-expanded='true'] .menu-bars i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-bars i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 39;
    padding: calc(var(--header-h) + env(safe-area-inset-top, 0px) + 32px) max(var(--gutter), env(safe-area-inset-right, 0px))
      calc(32px + env(safe-area-inset-bottom, 0px)) max(var(--gutter), env(safe-area-inset-left, 0px));
    background: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .mobile-menu ul {
    display: grid;
    gap: 4px;
  }
  .mobile-menu a {
    display: block;
    font-size: var(--t-2xl);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.05;
    padding-block: 4px;
  }
  .mobile-menu:not([hidden]) li {
    animation: rise 0.6s var(--ease) both;
    animation-delay: calc(var(--i) * 50ms);
  }

  @media (max-width: 760px) {
    .site-header {
      grid-template-columns: 1fr auto;
    }
    .nav,
    .clock {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }
</style>
